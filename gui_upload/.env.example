FLASK_SECRET_KEY=replace-with-a-long-random-value
RUNNER_API_TOKEN=replace-with-a-long-random-value
ANSIBLE_API_URL=http://ansible-runner:8000
UPLOAD_DIRECTORY=/app/incoming/new
LOG_DIRECTORY=/app/logs
MAX_UPLOAD_MB=10
REQUEST_TIMEOUT_SECONDS=1800
RUNNER_HEALTH_TIMEOUT=5
VERIFY_RUNNER_TLS=true
COMPANY_NAME=Alshaya Group
APP_TITLE=POS XML Automation
ENVIRONMENT_NAME=Production
SESSION_COOKIE_SECURE=false
